# OpenAI (or any OpenAI-compatible provider)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Set to 1 to skip real model calls and use a deterministic stub — useful
# for testing the graph traversal/UI without spending API calls.
LLM_STUB=0

# Inngest (only needed if deploying — local dev mode needs no keys)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
