PORT=3000

# --- LLM provider config ---
# OpenRouter (hosted, free tier): LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_API_KEY=your real key, LLM_MODEL=openrouter/free
# Ollama (local, free, unlimited): LLM_BASE_URL=http://localhost:11434/v1/, LLM_API_KEY=ollama, LLM_MODEL=gemma3:1b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Set to 1 to skip the model entirely and return a fixed stub response (no cost, no network).
LLM_STUB=0

# Set to false to disable the model call and return a clean 503 (kill switch).
LLM_ENABLED=true
